{
  "name": "telemetry-dashboard-appkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-Time Telemetry Pipeline — Intraday Public Trades Dashboard (Databricks AppKit, Node/React/TypeScript). Live reads from Lakebase `trades_latest`; history/aggregates via a Serverless SQL Warehouse.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server/index.ts",
    "build": "node -e \"console.log('Prebuilt: client_bundle/ + server_bundle/ are shipped; nothing to build at deploy time.')\"",
    "build:app": "vite build && tsdown",
    "build:client": "vite build",
    "build:server": "tsdown",
    "start": "node server_bundle/index.js",
    "test": "tsx scripts/check_monitor_logic.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deploy:dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./deploy-dev.ps1",
    "deploy:dev:fast": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./deploy-dev.ps1 -SkipBuild"
  },
  "devDependencies": {
    "@databricks/appkit": "^0.43.0",
    "@databricks/appkit-ui": "^0.21.0",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "express": "^5.0.0",
    "globals": "^15.0.0",
    "lightweight-charts": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.2",
    "tsdown": "^0.20.3",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "overrides": {
    "drizzle-orm": ">=0.45.2"
  },
  "dependencies": {}
}
